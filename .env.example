# Copy this file to .env.local and fill in the values.

# Login for the requests dashboard at /admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional: email a copy of every client request (leave empty to only save them in data/requests.json)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REQUEST_NOTIFY_TO=info@hieron.com.tr
